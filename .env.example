# 本地开发环境示例：复制为 .env.local 后按需修改。

########################################
# 站点地址
########################################

# Site URL
# [基础必填] 站点的公开地址，不含结尾斜杠。用于 canonical、sitemap、robots 和 OG 链接。
# 本地开发可以不填，默认 http://localhost:3000。
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Base Path
# [可选] 部署在子路径时填写，必须以 / 开头且不以 / 结尾。正式域名留空。
# GitHub Pages 预览使用 /clipo-plugin-website。
# NEXT_PUBLIC_BASE_PATH=""

########################################
# 构建方式
########################################

# Build Target
# [可选] 填 static 时导出纯静态站点到 out/（GitHub Pages 预览）；留空则输出 standalone，供 Docker 运行。
# BUILD_TARGET=""

########################################
# 本地运行
########################################

# Port
# [可选] next start 和 Docker 镜像监听的端口。
PORT="3000"
