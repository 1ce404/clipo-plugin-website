# 生产环境示例：在部署平台配置以下变量，不要把真实值提交到仓库。

########################################
# 站点地址
########################################

# Site URL
# [基础必填] 正式站点地址，不含结尾斜杠。
NEXT_PUBLIC_SITE_URL="https://clipo.cloud"

# Base Path
# [可选] 正式域名部署在根路径，保持为空。
# NEXT_PUBLIC_BASE_PATH=""

########################################
# 本地运行
########################################

# Port
# [可选] Docker 镜像监听的端口。
PORT="3000"
